# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
# Universal multi-server mode: leave DISCORD_GUILD_IDS empty and run npm run register
# to publish global slash commands for every server that invites the bot.
# Optional fast-update mode: comma-separated guild/server IDs for guild-only commands.
DISCORD_GUILD_IDS=

# Google GenAI. Use a real key only in .env, never in .env.example.
AI_API_KEY=your_google_ai_studio_api_key
AI_MODEL=gemma-4-31b-it
AI_TEMPERATURE=0.2
GOOGLE_THINKING_LEVEL=high
GOOGLE_ENABLE_SEARCH=true
GOOGLE_ENABLE_URL_CONTEXT=true
GOOGLE_INCLUDE_SOURCES=true

# Bot behavior
BOT_PREFIX=!agent
# Universal mode: leave ALLOWED_CHANNEL_IDS empty so every server can use the bot
# in DMs, mentions, slash commands, and BOT_PREFIX messages.
# Restricted mode: comma-separated channel IDs across any servers where the agent may respond.
ALLOWED_CHANNEL_IDS=
# Set true only if you intentionally want agent-to-agent / bot-to-bot messages.
DISCORD_ALLOW_BOT_MESSAGES=false
# Comma-separated Discord user IDs allowed to use admin-only features across all servers.
ADMIN_USER_IDS=

# YouTube voice playback
YT_DLP_COMMAND=yt-dlp
FFMPEG_COMMAND=ffmpeg
YT_DEFAULT_VOLUME=0.40
YT_PLAYLIST_LIMIT=26
YT_QUEUE_PAGE_SIZE=10
YT_PRIVATE_COMMAND_MESSAGES=true
YT_PREFIX_DELETE_MS=20000
# Keep media tool terminal logs short. Set verbose true only while debugging.
YT_MEDIA_TOOL_LOG_LINES=5
YT_VERBOSE_MEDIA_TOOL_LOGS=false
# Optional. Use only when YouTube requires cookies for your use case.
YT_DLP_COOKIES=

# Spotify link expansion. Without these, /suy play can queue a best single
# YouTube match from Spotify embed metadata, but cannot expand albums/playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PLAYLIST_LIMIT=26

# Agent storage
AGENT_WORKSPACE=agent_workspace
DATA_DIR=data
MAX_HISTORY_MESSAGES=24
MAX_TOOL_ROUNDS=5

# Local command execution is disabled by default.
# If enabled, only commands whose first token is in ALLOWED_COMMANDS can run.
ALLOW_SHELL_TOOLS=false
ALLOWED_COMMANDS=node,npm,git
COMMAND_TIMEOUT_MS=15000
